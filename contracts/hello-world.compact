pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public result stored on the blockchain.
// Only the eligibility result is exposed.
export ledger eligible: Boolean;

// Private input supplied by the user.
// It is used as a witness and is NOT stored on the public ledger.
witness userAge(): Uint<8>;

// Verify whether the private age satisfies the eligibility requirement.
export circuit verifyEligibility(): [] {
    const age = userAge();

    // Only disclose the final Boolean result.
    eligible = disclose(age >= 18);
}

